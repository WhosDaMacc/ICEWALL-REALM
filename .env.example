# Network Configuration
PRIVATE_KEY=your_wallet_private_key
ETHERSCAN_API_KEY=your_etherscan_api_key
SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=icewall_realm

# Ethereum Network Configuration
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-project-id

# Contract Addresses
BUSINESS_PROFILE_CONTRACT=
REALM_SYSTEM_CONTRACT=
USER_MANAGEMENT_CONTRACT=

# Email Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@icewallrealm.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# AR Configuration
ENABLE_AR=true
AR_UPDATE_INTERVAL=5000

# Server Configuration
PORT=3000
NODE_ENV=development

# Logging Configuration
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=11155111 # Sepolia
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key

# API Configuration
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_WS_URL=ws://localhost:3001

# Authentication
REACT_APP_AUTH0_DOMAIN=your-auth0-domain.auth0.com
REACT_APP_AUTH0_CLIENT_ID=your-auth0-client-id
REACT_APP_AUTH0_AUDIENCE=your-auth0-audience

# Feature Flags
REACT_APP_ENABLE_BATTLE_SYSTEM=true
REACT_APP_ENABLE_MAP_SYSTEM=true
REACT_APP_ENABLE_SOCIAL_FEATURES=true
REACT_APP_ENABLE_SOUND=true
REACT_APP_ENABLE_ANIMATIONS=true
REACT_APP_DEBUG_MODE=false

# Analytics
REACT_APP_GA_TRACKING_ID=your-ga-tracking-id

# Development
REACT_APP_DEBUG=true
REACT_APP_LOG_LEVEL=debug

# Production
# REACT_APP_DEBUG=false
# REACT_APP_LOG_LEVEL=error

# Google Maps API Key (for realm map)
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Battle Configuration
REACT_APP_MAX_COMBO=100
REACT_APP_SPECIAL_MOVE_COST=50
REACT_APP_FUSION_DAMAGE_MULTIPLIER=0.8 